# Local development. Copy to .env and fill in.
PORT=8080
PUBLIC_URL=https://your-tunnel.ngrok.app   # Retell must reach webhooks + tools; use ngrok/cloudflared locally
DATABASE_URL=postgres://ringo:ringo@localhost:5432/ringo

# Auth: Cognito in AWS. AUTH_DEV_BYPASS=true lets you send `x-dev-user: <email>` locally. Never enable in prod.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AUTH_DEV_BYPASS=true

# Encryption of account numbers / PINs. In AWS set KMS_KEY_ID; locally a 32-byte base64 key.
KMS_KEY_ID=
DEV_ENCRYPTION_KEY=   # openssl rand -base64 32

# Retell (dashboard → API keys). Agent IDs are printed by `npm run retell:setup`.
RETELL_API_KEY=          # leave empty until Retell is set up; calls are refused
RETELL_OUTBOUND_AGENT_ID=
RETELL_BOOKING_AGENT_ID=
RETELL_INBOUND_AGENT_ID=

# Twilio (console). Create the Elastic SIP trunk by hand — see docs/setup.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=      # Twilio Verify, for proving the user owns their phone
TWILIO_SIP_TRUNK_SID=
TWILIO_TERMINATION_URI=          # e.g. ringo-prod.pstn.twilio.com
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# Optional shared outbound number for dev (before per-user numbers are provisioned)
DEFAULT_FROM_NUMBER=

# Safety limits
MAX_CALL_MINUTES=120
MAX_CONCURRENT_CALLS_PER_USER=2
