        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSContactsUsageDescription": "Ringo uses your contacts only when you pick someone for Ringo to call. Contacts never leave your phone except the one you choose.",
        "LSApplicationQueriesSchemes": [
          "tel"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
