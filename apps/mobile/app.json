    "android": {
      "package": "app.ringo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ringo-mark-1024.png",
        "backgroundColor": "#0b0f1a"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/ringo-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7c6cf6"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Ringo uses your contacts only when you pick someone for Ringo to call. Contacts never leave your phone except the one you choose."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "usesCleartextTraffic": false
          }
        }
