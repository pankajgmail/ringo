{
  "expo": {
    "name": "Ringo",
    "slug": "ringo",
    "scheme": "ringo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ringo-icon-1024.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f1a",
